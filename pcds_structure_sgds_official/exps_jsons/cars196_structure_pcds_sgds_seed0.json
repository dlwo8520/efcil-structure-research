{
    "prefix": "cars196_structure_pcds_sgds_seed0",
    "experiment_name": "cars196_10task_official_structure",
    "method_label": "pcds_structure_sgds",
    "dataset": "car196",
    "data_root": "${RESEARCH_WORKSPACE}/cds-main/data/cars196",
    "num_classes": 196,
    "shuffle": true,
    "class_order_seed": 1993,
    "ssca": true,
    "ca": true,

    "init_cls": 20,
    "increment": 20,

    "model_name": "adapter",
    "convnet_type": "pretrained_vit_b16_224_in21k_adapter",
    "device": ["0"],
    "seed": [0],

    "init_epochs": 70,
    "inc_epochs": 40,
    "ca_epochs": 5,
    "init_lr": 0.005,
    "batch_size": 32,
    "statistics_batch_size": 64,
    "num_workers": 8,
    "weight_decay": 0.0005,
    "min_lr": 0,
    "ffn_num": 64,
    "optimizer": "sgd",
    "vpt_type": "shallow",
    "prompt_token_num": 5,

    "scale": 20.0,
    "margin": 0.3,
    "gamma_weight": 10.0,
    "scc": true,
    "scc_value": 5.0,
    "feature": false,
    "logit": false,
    "apr": true,
    "adapter_placement": "attention",
    "adapter_interval": 1,
    "flag": 0,
    "cov": 10.0,

    "use_sgds": true,
    "sgds_target_layer": 11,
    "sgds_k": 0.6,
    "sgds_k_interpretation": "60 percent retain, approximately 40 percent zero after Bernoulli and Top-K",
    "sgds_beta": 0.5,
    "sgds_gamma": 1.0,
    "sgds_exploration_ratio": 0.5,
    "sgds_mask_seed": 100003,
    "sgds_rng_isolated_from_training": true,
    "sgds_scope": "Eq. (4)-(10) activation guidance only; no SGDS adapter bank/retrieval/fusion/classifier",

    "record_results": true,
    "output_root": "${RESEARCH_WORKSPACE}/pcds_structure_sgds_official/outputs"
}
