{
    "prefix": "cdsp_proto_baseline",
    "method": "prototype_baseline",
    "dataset": "cifar224",
    "shuffle": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "cdsp",
    "convnet_type": "pretrained_vit_b16_224_in21k_adapter",
    "device": ["0"],
    "seed": [1993],
    "init_epochs": 20,
    "inc_epochs": 10,
    "init_lr": 0.01,
    "batch_size": 48,
    "weight_decay": 0.0005,
    "min_lr": 0,
    "ffn_num": 64,
    "optimizer": "sgd",
    "scale": 20.0,
    "margin": 0.0,
    "adapter_placement": "mlp",
    "adapter_interval": 1,
    "eval_classifier": "prototype",
    "subspace_mode": "none",
    "protected_layers": "all",
    "apr": false,
    "scc": false,
    "ca": false,
    "ca_epochs": 0,
    "feature": false,
    "logit": false,
    "project_gradient": false,
    "project_after_step": false,
    "freeze_adapter_bias": false,
    "inter_energy": 0.95,
    "intra_energy": 0.90,
    "task_energy": 0.95,
    "result_root": "results",
    "save_checkpoints": true,
    "num_workers": 8
}
