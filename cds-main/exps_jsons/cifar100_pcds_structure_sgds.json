{
  "experiment_runner": "pcds_structure_sgds",
  "experiment_name": "cifar100_10task",
  "method_label": "pcds_structure_sgds",
  "dataset": "cifar100",
  "data_root": "/data/datasets/cifar100",
  "output_root": "${RESEARCH_WORKSPACE}/cds-main/results/pcds_structure_sgds",
  "seed": 0,
  "num_tasks": 10,
  "classes_per_task": 10,
  "class_order": "god_seed1993",

  "keep_lora_config": "${RESEARCH_WORKSPACE}/projects/efcil_direction_diagnostic/configs/keeplora_efcil_cifar100_10task.yaml",
  "keep_lora_class_order": "${RESEARCH_WORKSPACE}/projects/efcil_direction_diagnostic/outputs/keeplora_efcil/cifar100_10task/seed_0/vanilla_lora/class_order.json",
  "pcds_baseline_summary": "${RESEARCH_WORKSPACE}/projects/efcil_direction_diagnostic/outputs/pcds_efcil/cifar100_10task/seed_0/comparison/summary.json",
  "pcds_baseline_dir": "${RESEARCH_WORKSPACE}/projects/efcil_direction_diagnostic/outputs/pcds_efcil/cifar100_10task/seed_0/pcds_full",
  "result_document": "${RESEARCH_WORKSPACE}/cds-main/RESULTS_PCMD.md",

  "model_name": "vit_base_patch16_224.augreg_in21k",
  "pretrained": true,
  "image_size": 224,
  "adaptation_type": "nonlinear_ffn_output_adapter",
  "adapter_bottleneck": 64,
  "adapter_dropout": 0.1,
  "classifier_scale": 20.0,

  "epochs_per_task": 10,
  "batch_size": 48,
  "statistics_batch_size": 192,
  "eval_batch_size": 192,
  "num_workers": 6,
  "learning_rate": 0.01,
  "min_learning_rate": 0.0,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "amp": true,
  "grad_scaler_init_scale": 256.0,
  "grad_scaler_growth_interval": 100000,
  "fail_on_optimizer_skip": true,

  "scc_weight": 2.0,
  "apr_gamma": 10.0,
  "apr_rho": 10.0,
  "prototype_covariance_epsilon": 0.001,
  "apr_epsilon": 0.000001,
  "ca_epochs": 5,
  "ca_learning_rate": 0.01,
  "ca_samples_per_class": 256,
  "ca_batch_size": 256,
  "ca_covariance_jitter": 0.000001,

  "use_sgds": true,
  "sgds_target_layers": [-1],
  "sgds_sparsity": 0.60,
  "sgds_k_interpretation": "paper_k_is_TopK_retain_ratio",
  "sgds_requested_zero_ratio": 0.40,
  "sgds_beta": 0.5,
  "sgds_gamma": 1.0,
  "sgds_exploration_ratio": 0.5,
  "sgds_epsilon": 1e-12,
  "sgds_eq6_includes_self": true,
  "sgds_training_only_mask": true,
  "sgds_token_reduction": "mean_absolute_magnitude",

  "raw_replay": false,
  "task_id_masking": false,
  "log_every_steps": 25,
  "save_every_task": true
}
